---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import icon from "../assets/icon.svg";
import homeLand from "../assets/screens/home-land.png";
import Showcase from "../components/Showcase.astro";
---
<Base
  title="YaeDock · Your Linux PC, docked on your phone"
  description="YaeDock turns an Android phone into a live stats panel and control dock for your Linux PC: CPU, GPU, game FPS, volume and brightness. Open source, local only, no accounts."
>
<a class="skip" href="#main">Skip to content</a>

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top" aria-label="YaeDock home">
      <img src={icon.src} width="34" height="34" alt="">
      <span>YaeDock</span>
    </a>
    <nav aria-label="Sections">
      <ul class="nav-links">
        <li><a href="#features">Features</a></li>
        <li><a href="#screens">Screens</a></li>
        <li><a href="#install">Install</a></li>
        <li><a href="#privacy">Privacy</a></li>
      </ul>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
    </button>
    <a class="btn btn-ghost btn-sm" href="https://github.com/DragonEmperor9480/yaedock">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2z"/></svg>
      <span>GitHub</span>
    </a>
  </div>
</header>

<main id="main">

<!-- Hero -->
<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Open source · Linux · Android</p>
      <h1>Your Linux PC,<br><span class="pink">docked</span> on your phone.</h1>
      <p class="lede">YaeDock turns the phone beside your keyboard into a live stats panel and control dock. CPU, GPU and game frame rates at a glance. Volume, brightness and recording a tap away.</p>
      <div class="cta">
        <a class="btn btn-primary" href="https://github.com/DragonEmperor9480/yaedock/releases/latest">
          Download
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg>
        </a>
        <a class="btn btn-ghost" href="#install">How to install</a>
      </div>
      <ul class="hero-facts" aria-label="At a glance">
        <li>Free and GPL-3.0</li>
        <li>No account</li>
        <li>Stays on your Wi-Fi</li>
      </ul>
    </div>

    <div class="hero-art">
      <svg class="gauge" viewBox="0 0 108 108" role="img" aria-label="The YaeDock fox inside a gauge">
        <circle cx="54" cy="54" r="44" fill="none" style="stroke: var(--dots)" stroke-width="0.6" stroke-dasharray="1.2 3.4"/>
        <circle cx="54" cy="54" r="30" fill="none" style="stroke: var(--track)" stroke-width="4.4" stroke-linecap="round" stroke-dasharray="141.4 47.1" transform="rotate(135 54 54)"/>
        <circle class="gauge-fill" cx="54" cy="54" r="30" fill="none" stroke="#F49AC1" stroke-width="4.4" stroke-linecap="round" stroke-dasharray="96 92.5" transform="rotate(135 54 54)"/>
        <g class="bob">
          <g transform="translate(54 55) scale(0.6) translate(-54 -54)">
            <path d="M35 29L46 44H62L73 29L77 52L70 64L54 78L38 64L31 52Z" fill="#F49AC1" stroke="#F49AC1" stroke-width="2" stroke-linejoin="round"/>
            <path d="M36.5 33.5L43.5 43.5L34 47Z" fill="#C2457E" stroke="#C2457E" stroke-width="1.2" stroke-linejoin="round"/>
            <path d="M71.5 33.5L64.5 43.5L74 47Z" fill="#C2457E" stroke="#C2457E" stroke-width="1.2" stroke-linejoin="round"/>
            <path d="M38 63L46.5 58.5L54 64L61.5 58.5L70 63L54 78Z" fill="#FFF1F6" stroke="#FFF1F6" stroke-width="2" stroke-linejoin="round"/>
            <path d="M41 51L48.5 55M67 51L59.5 55" fill="none" stroke="#2A0F1E" stroke-width="3.4" stroke-linecap="round"/>
            <path d="M51 64.5H57L54 68Z" fill="#2A0F1E" stroke="#2A0F1E" stroke-width="1.4" stroke-linejoin="round"/>
          </g>
        </g>
        <circle class="pulse" cx="54" cy="82" r="2.6" style="fill: var(--mint)"/>
        <g class="orbit"><circle cx="54" cy="10" r="1.6" style="fill: var(--amber)"/></g>
      </svg>
      <figure class="device device-land hero-device">
        <Image src={homeLand} widths={[640, 960, 1280]} sizes="(max-width: 960px) 92vw, 560px" alt="YaeDock's Home screen in landscape: the time, CPU, GPU and memory, sound and quick controls" loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </div>
</section>

<!-- Ticker of what it shows -->
<section class="ticker" aria-label="What it shows">
  <div class="ticker-track">
    <ul>
      <li>CPU load</li><li>Every GPU</li><li>Temperatures</li><li>Memory</li><li>Network</li><li>Disk</li><li>Battery</li><li>Game FPS</li><li>1% lows</li><li>Volume</li><li>Per-app volume</li><li>Brightness</li><li>Media</li><li>Power profiles</li><li>Screenshots</li><li>Recording</li><li>Lock and sleep</li><li>Your shortcuts</li>
    </ul>
    <ul aria-hidden="true">
      <li>CPU load</li><li>Every GPU</li><li>Temperatures</li><li>Memory</li><li>Network</li><li>Disk</li><li>Battery</li><li>Game FPS</li><li>1% lows</li><li>Volume</li><li>Per-app volume</li><li>Brightness</li><li>Media</li><li>Power profiles</li><li>Screenshots</li><li>Recording</li><li>Lock and sleep</li><li>Your shortcuts</li>
    </ul>
  </div>
</section>

<!-- Features -->
<section class="section" id="features">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="kicker">Features</p>
      <h2>Everything you alt-tab for,<br>on a second screen you already own.</h2>
    </header>

    <div class="bento">
      <article class="card card-stats reveal">
        <div class="card-text">
          <h3>Live stats</h3>
          <p>CPU, each GPU, memory, temperatures, network, disk and battery, updated live. Laptops with two GPUs show both, named, and Home follows the busy one.</p>
        </div>
        <div class="rings" aria-hidden="true">
<div class="ring" style="--v: 42; --c: var(--mint)" data-ring="cpu">
            <div class="ring-dial"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26"/><circle class="arc" cx="32" cy="32" r="26"/></svg><span class="ring-value"><b data-value>42</b>%</span></div>
            <span class="ring-label">CPU</span><span class="ring-detail" data-detail>54 °C</span>
          </div>
          <div class="ring" style="--v: 67; --c: var(--amber)" data-ring="gpu">
            <div class="ring-dial"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26"/><circle class="arc" cx="32" cy="32" r="26"/></svg><span class="ring-value"><b data-value>67</b>%</span></div>
            <span class="ring-label">GPU</span><span class="ring-detail" data-detail>66 °C</span>
          </div>
          <div class="ring" style="--v: 58; --c: var(--pink)" data-ring="memory">
            <div class="ring-dial"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26"/><circle class="arc" cx="32" cy="32" r="26"/></svg><span class="ring-value"><b data-value>58</b>%</span></div>
            <span class="ring-label">Memory</span><span class="ring-detail" data-detail>9.3 of 16 GiB</span>
          </div>
        </div>
      </article>

      <article class="card card-fps reveal">
        <h3>Game frame rates</h3>
        <p>FPS plus 1% and 0.1% lows through MangoHud, without an overlay in your game.</p>
        <div class="fps" aria-hidden="true">
          <span class="fps-num" data-fps>144</span><span class="fps-unit">fps</span>
          <div class="fps-lows"><span>1% <b>118</b></span><span>0.1% <b>96</b></span></div>
        </div>
      </article>

      <article class="card card-controls reveal">
        <h3>Controls</h3>
        <p>Volume, per-app volume, mic, brightness, media, power profiles, lock, sleep and power off.</p>
        <div class="sliders" aria-hidden="true">
          <div class="slider"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><div class="track"><i class="fill amber" style="--w: 72%"></i></div></div>
          <div class="slider"><svg viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/></svg><div class="track"><i class="fill mint" style="--w: 45%"></i></div></div>
        </div>
      </article>

      <article class="card card-capture reveal">
        <h3>Capture</h3>
        <p>Silent screenshots with Spectacle and screen recording with OBS Studio, started from the phone.</p>
        <div class="rec" aria-hidden="true"><span class="rec-dot"></span><span class="rec-time">00:42</span></div>
      </article>

      <article class="card card-shortcuts reveal">
        <h3>Your shortcuts</h3>
        <p>Your own buttons that run commands on the PC.</p>
        <div class="chips" aria-hidden="true"><span>git pull</span><span>Start server</span><span>Night light</span></div>
      </article>

      <article class="card card-night reveal">
        <div class="card-text">
          <h3>A real dock</h3>
          <p>A landscape layout for a stand, a pure-black night mode for OLED screens, and the screen kept on while charging.</p>
        </div>
        <div class="night" aria-hidden="true"><span class="night-time">23:47</span><span class="night-sub">CPU 12% · GPU asleep</span></div>
      </article>
    </div>
  </div>
</section>

<!-- Screens -->
<section class="section" id="screens">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="kicker">Screens</p>
      <h2>Made for a glance<br>from across the desk.</h2>
    </header>
    <div class="reveal"><Showcase /></div>
  </div>
</section>

<!-- Install -->
<section class="section" id="install">
  <div class="wrap install-grid">
    <header class="section-head reveal">
      <p class="kicker">Install</p>
      <h2>Three steps. About a minute.</h2>
      <p class="muted">You need a Linux PC with systemd and an Android 8.0+ phone on the same network.</p>
    </header>

    <ol class="steps">
      <li class="step reveal">
        <span class="step-n">1</span>
        <div>
          <h3>Install on the PC</h3>
          <p>Download the program and run its installer. It checks your PC, starts YaeDock in the background and shows a QR code.</p>
          <div class="code" data-copy>
            <pre><code><span class="c-prompt">$</span> curl -LO https://github.com/DragonEmperor9480/yaedock/releases/latest/download/yaedock
<span class="c-prompt">$</span> chmod +x yaedock &amp;&amp; ./yaedock --install</code></pre>
            <button class="copy" type="button" aria-label="Copy the install commands">Copy</button>
          </div>
        </div>
      </li>
      <li class="step reveal">
        <span class="step-n">2</span>
        <div>
          <h3>Get the app and scan</h3>
          <p>Install the APK for your phone from the <a href="https://github.com/DragonEmperor9480/yaedock/releases/latest">latest release</a> (arm64-v8a for almost every phone), then scan the QR code.</p>
        </div>
      </li>
      <li class="step reveal">
        <span class="step-n">3</span>
        <div>
          <h3>Dock it</h3>
          <p>Stand the phone next to your monitor. It reconnects by itself whenever both are on.</p>
        </div>
      </li>
    </ol>
  </div>
  <div class="wrap">
    <div class="terminal reveal" aria-label="Example: yaedock check output">
      <div class="term-bar"><i></i><i></i><i></i><span>yaedock check</span></div>
      <pre><code><span class="dim">Checking this PC…</span>

<span class="ok">✓</span> systemd       User services are available
<span class="ok">✓</span> Stats         CPU (8 threads), RAM (15.5 GiB), disk and network
<span class="ok">✓</span> Brightness    Built-in display at 75%, changed through logind
<span class="ok">✓</span> Volume        PipeWire (wpctl) at 31%, live updates
<span class="ok">✓</span> Recording     Through OBS Studio, with its own scene and output settings
<span class="ok">✓</span> Game FPS      Games started with MangoHud send their frame rate
<span class="ok">✓</span> Daemon        Running in the background and starts at login

<span class="ok">18 working</span>, 0 with limits, 0 not working</code></pre>
    </div>
  </div>
</section>

<!-- Privacy -->
<section class="section" id="privacy">
  <div class="wrap privacy">
    <div class="privacy-art reveal" aria-hidden="true">
      <span class="ripple"></span><span class="ripple r2"></span>
      <span class="shield"><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
    </div>
    <div>
      <header class="section-head reveal">
        <p class="kicker">Privacy</p>
        <h2>Stays between you<br>and your PC.</h2>
      </header>
      <ul class="facts">
        <li class="reveal"><b>Your Wi-Fi only.</b> The phone talks straight to your PC. Nothing goes through a server.</li>
        <li class="reveal"><b>Encrypted and pinned.</b> TLS on every connection, and the phone trusts only the PC it paired with.</li>
        <li class="reveal"><b>No account, no cloud, no tracking.</b> There's nothing to sign up for.</li>
        <li class="reveal"><b>Open source.</b> GPL-3.0, so you can read every line.</li>
      </ul>
    </div>
  </div>
</section>

<!-- Final call -->
<section class="section final">
  <div class="wrap final-inner reveal">
    <img src={icon.src} width="88" height="88" alt="">
    <h2>Give your phone a job.</h2>
    <p class="muted">Free, open source, and made for Linux.</p>
    <div class="cta">
      <a class="btn btn-primary" href="https://github.com/DragonEmperor9480/yaedock/releases/latest">Download YaeDock</a>
      <a class="btn btn-ghost" href="https://github.com/DragonEmperor9480/yaedock">Star on GitHub</a>
    </div>
  </div>
</section>

</main>

<footer class="footer">
  <div class="wrap footer-inner">
    <span>Made by <a href="https://github.com/DragonEmperor9480">DragonEmperor9480</a> with Rust and Kotlin.</span>
    <span><a href="https://github.com/DragonEmperor9480/yaedock/blob/master/LICENSE">GPL-3.0-or-later</a> · <a href="https://github.com/DragonEmperor9480/yaedock/issues">Report a problem</a></span>
  </div>
</footer>
</Base>
