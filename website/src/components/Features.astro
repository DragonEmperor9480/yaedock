                {f.id === "dock" && (
                  <svg viewBox="0 0 320 180" class="sc-dock">
                    <rect x="46" y="28" width="228" height="118" rx="18" fill="#000" stroke="#232A35" stroke-width="2"/>
                    <text class="dock-clock" x="160" y="98" text-anchor="middle">23<tspan class="colon">:</tspan>47</text>
                    <text class="clock-sub" x="160" y="122" text-anchor="middle">CPU 12% · GPU asleep</text>
                    <g class="themes">
                      <circle cx="120" cy="164" r="6" fill="#5BE7C4"/>
                      <circle cx="140" cy="164" r="6" fill="#E07A4F"/>
                      <circle cx="160" cy="164" r="6" fill="#D7DCE3"/>
                      <circle cx="180" cy="164" r="6" fill="#5AB4F0"/>
                      <circle cx="200" cy="164" r="6" fill="#F49AC1"/>
                      <circle class="pick" cx="120" cy="164" r="10"/>
                    </g>
                  </svg>
