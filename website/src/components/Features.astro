                {f.id === "mirror" && (
                  <svg viewBox="0 0 320 180">
                    <rect class="s-body" x="18" y="24" width="172" height="108" rx="9"/>
                    <rect class="s-screen" x="24" y="30" width="160" height="96" rx="5"/>
                    <g class="mirror-src">
                      <rect class="s-ui" x="30" y="36" width="28" height="84" rx="4"/>
                      {[0, 1, 2, 3, 4].map((i) => <rect class={`s-on bar b${i}`} x={70 + i * 22} y="56" width="14" height="60" rx="3"/>)}
                      <path class="s-cursor a-pointer" d="M100 60v13l3.5-3.2 2.6 5.6 2.4-1.1-2.6-5.5h4.8z"/>
                    </g>
                    <path class="s-stand" d="M92 132h24l4 14H88z"/>
                    <rect class="s-body" x="78" y="146" width="52" height="5" rx="2.5"/>
                    <rect class="s-body" x="206" y="62" width="104" height="62" rx="11"/>
                    <rect class="s-screen" x="212" y="68" width="92" height="50" rx="6"/>
                    <g transform="translate(216.5 68) scale(0.52) translate(-24 -30)">
                      <rect class="s-ui" x="30" y="36" width="28" height="84" rx="4"/>
                      {[0, 1, 2, 3, 4].map((i) => <rect class={`s-on bar b${i}`} x={70 + i * 22} y="56" width="14" height="60" rx="3"/>)}
                      <path class="s-cursor a-pointer" d="M100 60v13l3.5-3.2 2.6 5.6 2.4-1.1-2.6-5.5h4.8z"/>
                    </g>
                    <circle class="s-rec a-rec" cx="296" cy="76" r="3"/>
                  </svg>
                )}

                {f.id === "mic" && (
                  <svg viewBox="0 0 320 180">
                    <rect class="s-body" x="34" y="34" width="62" height="114" rx="13"/>
                    <rect class="s-screen" x="39" y="39" width="52" height="104" rx="9"/>
                    <circle class="s-accent pulse" cx="65" cy="84" r="17"/>
                    <path class="s-on-accent-line" d="M65 76v8M60 84a5 5 0 0 0 10 0M65 89v3"/>
                    <rect class="s-on-accent" x="62" y="74" width="6" height="12" rx="3"/>
                    <rect class="s-rec" x="51" y="118" width="28" height="11" rx="5.5"/>
                    <text class="s-tag" x="65" y="126.5" text-anchor="middle">ON</text>
                    <g class="waves">
                      <path class="s-wave w1" d="M108 72a16 16 0 0 1 0 24"/>
                      <path class="s-wave w2" d="M116 64a28 28 0 0 1 0 40"/>
                      <path class="s-wave w3" d="M124 56a40 40 0 0 1 0 56"/>
                    </g>
                    <rect class="s-body" x="150" y="30" width="152" height="100" rx="9"/>
                    <rect class="s-screen" x="156" y="36" width="140" height="88" rx="5"/>
                    <text class="s-text" x="166" y="54">Input</text>
                    <rect class="s-selected" x="164" y="62" width="124" height="22" rx="6"/>
                    <circle class="s-accent" cx="176" cy="73" r="4"/>
                    <text class="s-text strong" x="186" y="76.5">Phone microphone</text>
                    <g class="levels">
                      {Array.from({ length: 14 }, (_, i) => <rect class={`lvl l${i % 7}`} x={166 + i * 8.6} y="96" width="5" height="18" rx="2"/>)}
                    </g>
                    <path class="s-stand" d="M216 130h22l4 14h-30z"/>
                    <rect class="s-body" x="204" y="144" width="46" height="5" rx="2.5"/>
                  </svg>
                )}

                {f.id === "speaker" && (
                  <svg viewBox="0 0 320 180">
                    <rect class="s-body" x="18" y="30" width="152" height="100" rx="9"/>
                    <rect class="s-screen" x="24" y="36" width="140" height="88" rx="5"/>
                    <text class="s-text" x="34" y="54">Output</text>
                    <rect class="s-ui" x="32" y="62" width="124" height="20" rx="6"/>
                    <text class="s-text" x="44" y="75.5">Speakers</text>
                    <rect class="s-selected" x="32" y="88" width="124" height="22" rx="6"/>
                    <circle class="s-accent" cx="44" cy="99" r="4"/>
                    <text class="s-text strong" x="54" y="102.5">Phone speaker</text>
                    <path class="s-stand" d="M84 130h22l4 14H80z"/>
                    <rect class="s-body" x="72" y="144" width="46" height="5" rx="2.5"/>
                    <g class="notes">
                      <path class="s-note n1" d="M184 90v-14l9-2v13M184 90a3 3 0 1 1-3-3M193 87a3 3 0 1 1-3-3"/>
                      <path class="s-note n2" d="M184 90v-14l9-2v13M184 90a3 3 0 1 1-3-3M193 87a3 3 0 1 1-3-3"/>
                      <path class="s-note n3" d="M184 90v-14l9-2v13M184 90a3 3 0 1 1-3-3M193 87a3 3 0 1 1-3-3"/>
                    </g>
                    <rect class="s-body" x="232" y="32" width="62" height="114" rx="13"/>
                    <rect class="s-screen" x="237" y="37" width="52" height="104" rx="9"/>
                    <path class="s-accent" d="M250 76h7l9-8v28l-9-8h-7z"/>
                    <path class="s-wave sw1" d="M270 76a8 8 0 0 1 0 12"/>
                    <path class="s-wave sw2" d="M274 71a15 15 0 0 1 0 22"/>
                    <rect class="s-rec" x="249" y="116" width="28" height="11" rx="5.5"/>
                    <text class="s-tag" x="263" y="124.5" text-anchor="middle">ON</text>
                  </svg>
                )}

                {f.id === "camera" && (
                  <svg viewBox="0 0 320 180">
                    <rect class="s-body" x="30" y="30" width="66" height="120" rx="13"/>
                    <rect class="s-screen dark" x="35" y="35" width="56" height="110" rx="9"/>
                    <g class="face">
                      <circle class="s-face" cx="63" cy="82" r="13"/>
                      <path class="s-face" d="M40 140c2-18 12-28 23-28s21 10 23 28z"/>
                    </g>
                    <path class="s-focus" d="M45 62v-8h8M73 54h8v8M81 104v8h-8M53 112h-8v-8"/>
                    <circle class="s-rec a-rec" cx="84" cy="42" r="3"/>
                    <g class="packets cam">
                      <rect x="104" y="86" width="10" height="7" rx="1.5"/><rect x="104" y="86" width="10" height="7" rx="1.5"/><rect x="104" y="86" width="10" height="7" rx="1.5"/>
                    </g>
                    <rect class="s-body" x="146" y="30" width="156" height="100" rx="9"/>
                    <rect class="s-screen" x="152" y="36" width="144" height="88" rx="5"/>
                    <rect class="s-screen dark" x="158" y="44" width="64" height="66" rx="5"/>
                    <clipPath id="cam-tile"><rect x="158" y="44" width="64" height="66" rx="5"/></clipPath>
                    <g clip-path="url(#cam-tile)">
                      <g class="face">
                        <circle class="s-face" cx="190" cy="72" r="10"/>
                        <path class="s-face" d="M170 112c2-14 10-22 20-22s18 8 20 22z"/>
                      </g>
                    </g>
                    <rect class="s-ui" x="226" y="44" width="64" height="66" rx="5"/>
                    <circle class="s-other" cx="258" cy="70" r="9"/>
                    <path class="s-other" d="M240 110c2-12 9-19 18-19s16 7 18 19z"/>
                    <path class="s-stand" d="M212 130h22l4 14h-30z"/>
                    <rect class="s-body" x="200" y="144" width="46" height="5" rx="2.5"/>
                  </svg>
                )}

                {f.id === "input" && (
                  <svg viewBox="0 0 320 180">
                    <rect class="s-body" x="14" y="16" width="180" height="112" rx="9"/>
                    <rect class="s-screen" x="20" y="22" width="168" height="100" rx="5"/>
                    <rect class="s-ui" x="30" y="32" width="148" height="10" rx="4"/>
                    <rect class="s-ui btn-target" x="150" y="54" width="28" height="14" rx="4"/>
                    <text class="s-text strong typed" x="32" y="106">Hello, World!</text>
                    <rect class="s-screen typing-cover" x="30" y="94" width="84" height="16"/>
                    <path class="s-cursor a-mouse" d="M60 50v13l3.5-3.2 2.6 5.6 2.4-1.1-2.6-5.5h4.8z"/>
                    <circle class="click-ring" cx="161" cy="55" r="8"/>
                    <path class="s-stand" d="M92 128h24l4 14H88z"/>
                    <rect class="s-body" x="78" y="142" width="52" height="5" rx="2.5"/>
                    <rect class="s-body" x="200" y="78" width="112" height="80" rx="12"/>
                    <rect class="s-screen" x="206" y="84" width="100" height="68" rx="7"/>
                    <rect class="s-pad" x="210" y="88" width="92" height="40" rx="5"/>
                    <circle class="finger" cx="224" cy="100" r="6"/>
                    <circle class="tap-ring" cx="254" cy="104" r="6"/>
                    {["Esc", "Ctrl", "Tab", "F5"].map((k, i) => (
                      <g class={`key k${i}`}>
                        <rect x={210 + i * 23.5} y="133" width="21" height="14" rx="3"/>
                        <text x={220.5 + i * 23.5} y="143" text-anchor="middle">{k}</text>
                      </g>
                    ))}
                  </svg>
                )}

                {f.id === "controller" && (
                  <svg viewBox="0 0 320 180">
                    <g class="pad">
                      <path class="buzz" d="M64 74v32M56 80v20M256 74v32M264 80v20"/>
                      <rect class="s-body" x="76" y="34" width="168" height="104" rx="18"/>
                      <rect class="s-screen dark" x="83" y="41" width="154" height="90" rx="12"/>
                      <rect class="s-ui trig lt" x="92" y="48" width="34" height="9" rx="4.5"/>
                      <rect class="s-ui trig rt" x="194" y="48" width="34" height="9" rx="4.5"/>
                      <circle class="s-ring" cx="114" cy="80" r="15"/>
                      <circle class="s-accent stick sl" cx="114" cy="80" r="8"/>
                      <circle class="s-ring" cx="186" cy="110" r="13"/>
                      <circle class="s-accent stick sr" cx="186" cy="110" r="7"/>
                      <path class="s-ui" d="M135 100h8v8h8v8h-8v8h-8v-8h-8v-8h8z"/>
                      <circle class="btn by" cx="206" cy="68" r="6"/>
                      <circle class="btn bx" cx="194" cy="80" r="6"/>
                      <circle class="btn bb" cx="218" cy="80" r="6"/>
                      <circle class="btn ba" cx="206" cy="92" r="6"/>
                      <rect class="s-ui" x="150" y="66" width="9" height="6" rx="3"/>
                      <rect class="s-ui" x="162" y="66" width="9" height="6" rx="3"/>
                    </g>
                    <text class="s-text" x="160" y="164" text-anchor="middle">YaeDock controller · connected</text>
                  </svg>
                )}
              </div>

              <div class="feat-body">
                <div class="feat-head">
                  <h4>{f.title}</h4>
                  {f.beta && <span class="beta">Beta</span>}
                </div>
                <p class="feat-sum">{f.summary}</p>
                <button class="feat-more" type="button" aria-expanded="false" aria-controls={`feat-${f.id}`}>
                  Details
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                </button>
              </div>

              <div class="feat-detail" id={`feat-${f.id}`}>
                <div class="feat-head">
                  <h4>{f.title}</h4>
                  {f.beta && <span class="beta">Beta</span>}
                  <button class="feat-close" type="button" aria-label={`Close the details of ${f.title}`}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                  </button>
                </div>
                <ul>
                  {f.details.map((d) => <li set:html={inline(d)} />)}
                </ul>
                {f.needs && <p class="feat-needs"><span>Needs</span> <Fragment set:html={inline(f.needs)} /></p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
