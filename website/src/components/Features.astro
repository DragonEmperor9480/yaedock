---
// The features: a grid of cards, each with a small looping scene of what it
// does. Its Details button slides the details up over it. Scenes only play while on screen, and hold still for reduced motion.
import "../styles/features.css";

type Feature = {
  id: string;
  title: string;
  summary: string;
  details: string[];
  needs?: string;
  beta?: boolean;
  wide?: boolean;
};

const onPhone: Feature[] = [
  {
    id: "stats",
    title: "Live stats",
    wide: true,
    summary: "CPU, every GPU, memory, temperatures, network, disk and battery, updated every second.",
    details: [
      "CPU load with its history, and temperatures",
      "Each GPU by name; laptops with two show both, and Home follows the busy one",
      "Memory, battery, network speed and disk",
      "About 0.3% of one CPU core on the PC while the app is open",
    ],
    needs: "Nothing extra.",
  },
  {
    id: "fps",
    title: "Game frame rates",
    summary: "FPS with 1% and 0.1% lows, without an overlay in your game.",
    details: [
      "Read from MangoHud: start games with it, such as the Steam launch option `mangohud %command%`",
      "Hide MangoHud's overlay on the PC and keep the numbers on the phone",
      "Turn it on with `yaedock fps on`, or from the menu",
    ],
    needs: "MangoHud.",
  },
  {
    id: "controls",
    title: "Controls",
    summary: "Volume, brightness and power, a tap away.",
    details: [
      "Volume for the PC and for each app, and the output it plays on",
      "The microphone and the built-in display's brightness",
      "Power profiles, lock, sleep and power off",
    ],
    needs: "PipeWire or PulseAudio for sound.",
  },
  {
    id: "media",
    title: "Media",
    summary: "What plays on the PC, with its cover and a seek bar.",
    details: [
      "Spotify, a browser tab or any player the PC can control",
      "Play, pause, skip and seek",
      "In the app and in the phone's notification shade",
    ],
    needs: "Nothing extra.",
  },
  {
    id: "capture",
    title: "Capture",
    summary: "Screenshots and screen recording, started from the phone.",
    details: [
      "Silent screenshots with Spectacle",
      "Start and stop recording in OBS Studio, with your own scenes and settings",
      "Set it up with `yaedock obs on`; OBS is reached on this PC only",
    ],
    needs: "Spectacle for screenshots, OBS Studio for recording.",
  },
  {
    id: "cable",
    title: "Wi-Fi or USB cable",
    summary: "Plug in for less delay; unplug and it goes back to Wi-Fi.",
    details: [
      "Switches to the cable by itself, with no tethering or developer settings",
      "No dropouts, so the screen and camera stay steady",
      "A new phone can pair over the cable, with no QR code",
    ],
    needs: "YaeDock's udev rule; `yaedock check` gives the command.",
  },
  {
    id: "shortcuts",
    title: "Your shortcuts",
    summary: "Buttons on the phone that run your commands on the PC.",
    details: [
      "Add one with `yaedock shortcuts add`",
      "The phone only sees a button's name, never its command",
      "New buttons show on the phone within a second",
    ],
    needs: "Nothing extra.",
  },
  {
    id: "dock",
    title: "A real dock",
    summary: "Landscape, a night mode, themes and big clocks.",
    details: [
      "A landscape layout for a stand, and the screen kept on while charging",
      "A pure-black night mode, easy on OLED",
      "Five colour themes with matching app icons, or import your own",
      "11 clock faces, or draw your own",
    ],
  },
];

const phoneAs: Feature[] = [
  {
    id: "extend",
    title: "Extend display",
    wide: true,
    summary: "Make the phone one more monitor, and drag windows onto it.",
    details: [
      "It appears beside your monitors; move it in your display settings",
      "1080p, 720p or 540p; a smaller picture makes everything larger",
      "H.264 at up to 60 frames a second",
      "It goes away when you leave the screen",
    ],
    needs: "Wayland with KDE Plasma or GNOME, and GStreamer.",
  },
  {
    id: "mirror",
    title: "Mirror",
    summary: "One of your monitors, live on the phone.",
    details: [
      "Up to 60 frames a second and 8 Mbit/s",
      "About a tenth of a CPU core with Intel or AMD graphics",
      "On a weak signal it pauses rather than falling behind",
    ],
    needs: "Wayland and GStreamer.",
  },
  {
    id: "mic",
    title: "Microphone",
    summary: "The phone's mic, for any program on the PC.",
    details: [
      "Named after the phone, like “Pixel 6 microphone”",
      "Never made the default: pick it where you need it",
      "Compressed to about 32 kbit/s",
      "No echo cancelling, so use headphones on calls",
    ],
    needs: "PipeWire or PulseAudio.",
  },
  {
    id: "speaker",
    title: "Speaker",
    beta: true,
    summary: "Play the PC's sound on the phone.",
    details: [
      "The PC gets an output named after the phone, and switches to it",
      "Stop, and it goes back to the output it used before",
      "About a sixth of a second behind the PC",
    ],
    needs: "PipeWire or PulseAudio.",
  },
  {
    id: "camera",
    title: "Camera",
    beta: true,
    summary: "The back or front camera as a webcam.",
    details: [
      "240p to 720p at 30 frames a second",
      "A PipeWire camera that browsers and OBS Studio find",
      "Lowers its quality by itself on a weak signal",
    ],
    needs: "PipeWire and GStreamer.",
  },
  {
    id: "input",
    title: "Keyboard & mouse",
    beta: true,
    summary: "A trackpad and keyboard for a PC across the room.",
    details: [
      "Tap to click; two fingers scroll or right-click; tap and hold to drag",
      "The phone's keyboard types on the PC",
      "Esc, Tab, the arrows, F1 to F12, and sticky Ctrl, Alt, Shift and Super",
      "Wayland or X11, on any desktop",
    ],
    needs: "Access to `/dev/uinput`; `yaedock check` says how.",
  },
  {
    id: "controller",
    title: "Game controller",
    beta: true,
    wide: true,
    summary: "Turn the phone sideways into a pad that games see as an Xbox-style controller.",
    details: [
      "Two sticks, a D-pad, A, B, X and Y, triggers and bumpers",
      "When a game rumbles, the phone vibrates",
      "An Xbox or symmetric layout, and the size of the sticks and buttons",
      "Each phone is one controller",
    ],
    needs: "Access to `/dev/uinput`, as for keyboard & mouse.",
  },
];

/** Escapes text and turns `backticks` into code. */
const inline = (text: string) =>
  text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>");

const groups = [
  { id: "on-phone", title: "On the phone", lede: "Everything about the PC, at a glance and a tap.", items: onPhone },
  {
    id: "phone-as",
    title: "Phone as",
    lede: "Lend the PC what the phone has. Each part shows up as a real device named after the phone, works with any program, and goes away when you stop.",
    items: phoneAs,
  },
];

// The network graph: two identical periods, so sliding by one loops cleanly.
const spark = (() => {
  const pts: string[] = [];
  for (let x = 0; x <= 400; x += 10) {
    const t = (x % 200) / 200;
    const y = 34 - 14 * Math.sin(t * Math.PI * 2) - 8 * Math.sin(t * Math.PI * 6) * Math.cos(t * Math.PI * 2);
    pts.push(`${x},${y.toFixed(1)}`);
  }
  return "M" + pts.join(" L");
})();
// Frame times for the FPS strip, two identical runs for the same reason.
const frames = [9, 12, 8, 14, 10, 7, 11, 16, 9, 8, 13, 10, 22, 9, 11, 8, 12, 10, 9, 15];
---
<section class="section features" id="features">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="kicker">Features</p>
      <h2>Everything you alt-tab for, <br>on a second screen you already own.</h2>
    </header>

    {groups.map((group) => (
      <div class="feat-group" id={group.id}>
        <div class="feat-group-head reveal">
          <h3>{group.title}</h3>
          <p>{group.lede}</p>
        </div>
        <div class="feat-grid">
          {group.items.map((f) => (
            <article class:list={["feat", "reveal", { wide: f.wide }]} data-feat={f.id}>
              <div class="feat-scene" aria-hidden="true">
                {f.id === "stats" && (
                  <div class="sc-stats">
                    <div class="rings">
                      <div class="ring" style="--v: 42; --c: var(--mint)" data-ring="cpu">
                        <div class="ring-dial"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26"/><circle class="arc" cx="32" cy="32" r="26"/></svg><span class="ring-value"><b data-value>42</b>%</span></div>
                        <span class="ring-label">CPU</span><span class="ring-detail" data-detail>54 °C</span>
                      </div>
                      <div class="ring" style="--v: 67; --c: var(--amber)" data-ring="gpu">
                        <div class="ring-dial"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26"/><circle class="arc" cx="32" cy="32" r="26"/></svg><span class="ring-value"><b data-value>67</b>%</span></div>
                        <span class="ring-label">GPU</span><span class="ring-detail" data-detail>66 °C</span>
                      </div>
                      <div class="ring" style="--v: 58; --c: var(--pink)" data-ring="memory">
                        <div class="ring-dial"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26"/><circle class="arc" cx="32" cy="32" r="26"/></svg><span class="ring-value"><b data-value>58</b>%</span></div>
                        <span class="ring-label">Memory</span><span class="ring-detail" data-detail>9.3 of 16 GiB</span>
                      </div>
                    </div>
                    <div class="net">
                      <span class="net-label">Network <b>↓ 13.2 MB/s</b></span>
                      <svg viewBox="0 0 200 56" preserveAspectRatio="none"><g class="a-spark"><path class="spark-fill" d={`${spark} L400,56 L0,56 Z`}/><path class="spark-line" d={spark}/></g></svg>
                    </div>
                  </div>
                )}

                {f.id === "fps" && (
                  <div class="sc-fps">
                    <div class="fps"><span class="fps-num" data-fps>144</span><span class="fps-unit">fps</span></div>
                    <div class="fps-lows"><span>1% <b>118</b></span><span>0.1% <b>96</b></span></div>
                    <svg class="frametimes" viewBox="0 0 200 40" preserveAspectRatio="none">
                      <g class="a-frames">
                        {[...frames, ...frames].map((h, i) => (
                          <rect x={i * 10 + 2} y={40 - h * 1.5} width="6" height={h * 1.5} rx="1.5" class={h > 15 ? "spike" : ""}/>
                        ))}
                      </g>
                    </svg>
                  </div>
                )}

                {f.id === "controls" && (
                  <div class="sc-controls">
                    <div class="sliders">
                      <div class="slider"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><div class="track"><i class="fill amber" style="--w: 72%"></i></div></div>
                      <div class="slider"><svg viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/></svg><div class="track"><i class="fill mint" style="--w: 45%"></i></div></div>
                    </div>
                    <div class="power">
                      <span><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
                      <span><svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></span>
                      <span><svg viewBox="0 0 24 24"><path d="M12 3v9M6.3 6.3a8 8 0 1 0 11.4 0"/></svg></span>
                      <span><svg viewBox="0 0 24 24"><path d="M13 3 5 14h6l-1 7 8-11h-6z"/></svg></span>
                    </div>
                  </div>
                )}

                {f.id === "media" && (
                  <svg viewBox="0 0 320 180">
                    <defs>
                      <linearGradient id="cover-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--pink)"/><stop offset="1" stop-color="var(--amber)"/></linearGradient>
                    </defs>
                    <rect class="s-panel" x="28" y="34" width="264" height="112" rx="16"/>
                    <rect x="44" y="50" width="80" height="80" rx="12" fill="url(#cover-grad)"/>
                    <g class="eq">
                      {[0, 1, 2, 3].map((i) => <rect class="s-on" x={62 + i * 12} y="94" width="7" height="26" rx="2"/>)}
                    </g>
                    <rect class="s-strong" x="140" y="56" width="104" height="10" rx="5"/>
                    <rect class="s-ui" x="140" y="74" width="66" height="8" rx="4"/>
                    <path class="s-icon" d="M159 103v12M171 103l-8 6 8 6z"/>
                    <circle class="s-accent" cx="196" cy="109" r="13"/>
                    <path class="s-on-accent" d="M192 103v12M200 103v12"/>
                    <path class="s-icon" d="M233 103v12M221 103l8 6-8 6z"/>
                    <rect class="s-track" x="140" y="128" width="136" height="4" rx="2"/>
                    <rect class="s-accent a-progress" x="140" y="128" width="136" height="4" rx="2"/>
                  </svg>
                )}

                {f.id === "capture" && (
                  <svg viewBox="0 0 320 180">
                    <rect class="s-body" x="26" y="24" width="186" height="116" rx="9"/>
                    <rect class="s-screen" x="32" y="30" width="174" height="104" rx="5"/>
                    <rect class="s-ui" x="42" y="40" width="70" height="44" rx="4"/>
                    <rect class="s-ui" x="120" y="40" width="76" height="8" rx="4"/>
                    <rect class="s-ui" x="120" y="54" width="54" height="8" rx="4"/>
                    <rect class="s-ui" x="42" y="92" width="154" height="32" rx="4"/>
                    <path class="s-stand" d="M108 140h22l4 14h-30z"/>
                    <rect class="s-body" x="96" y="154" width="46" height="5" rx="2.5"/>
                    <rect class="flash" x="32" y="30" width="174" height="104" rx="5"/>
                    <g class="shot">
                      <rect class="s-shot" x="32" y="30" width="174" height="104" rx="5"/>
                      <rect class="s-ui" x="42" y="40" width="70" height="44" rx="4"/>
                      <rect class="s-ui" x="42" y="92" width="154" height="32" rx="4"/>
                    </g>
                    <rect class="s-body" x="236" y="38" width="62" height="112" rx="12"/>
                    <rect class="s-screen" x="241" y="43" width="52" height="102" rx="8"/>
                    <circle class="s-ui" cx="267" cy="74" r="13"/>
                    <path class="s-icon" d="M260 71h3l2-3h4l2 3h3v9h-14z"/>
                    <circle class="s-ui" cx="267" cy="112" r="13"/>
                    <circle class="s-rec a-rec" cx="267" cy="112" r="6"/>
                    <text class="s-text rec-text" x="267" y="137" text-anchor="middle" data-rec>00:42</text>
                  </svg>
                )}

                {f.id === "cable" && (
                  <svg viewBox="0 0 320 180">
                    <rect class="s-body" x="24" y="40" width="120" height="78" rx="8"/>
                    <rect class="s-screen" x="30" y="46" width="108" height="66" rx="4"/>
                    <path class="s-body" d="M14 122h140l-8 10H22z"/>
                    <rect class="s-body" x="236" y="36" width="58" height="108" rx="12"/>
                    <rect class="s-screen" x="241" y="41" width="48" height="98" rx="8"/>
                    <g class="wifi">
                      <path class="s-dash" d="M146 72H232"/>
                      <path class="s-wave" d="M180 52a16 16 0 0 1 24 0M185 57a9 9 0 0 1 14 0"/>
                      <circle class="s-dot" cx="192" cy="62" r="2"/>
                      <g class="packets slow">
                        <circle cx="150" cy="72" r="3.5"/><circle cx="150" cy="72" r="3.5"/><circle cx="150" cy="72" r="3.5"/>
                      </g>
                    </g>
                    <g class="usb">
                      <path class="s-cable" d="M84 132v18q0 10 10 10h162q9 0 9-9v-1"/>
                      <rect class="s-plug" x="259" y="142" width="12" height="9" rx="2"/>
                      <g class="packets fast">
                        <circle cx="100" cy="160" r="3.5"/><circle cx="100" cy="160" r="3.5"/><circle cx="100" cy="160" r="3.5"/><circle cx="100" cy="160" r="3.5"/>
                      </g>
                    </g>
                    <text class="s-text lbl-wifi" x="189" y="88" text-anchor="middle">Wi-Fi</text>
                    <text class="s-text lbl-usb" x="178" y="176" text-anchor="middle">USB cable</text>
