                {f.id === "extend" && (
                  <svg viewBox="0 0 320 180">
                    <rect class="s-body" x="20" y="20" width="176" height="112" rx="9"/>
                    <rect class="s-screen" x="26" y="26" width="164" height="100" rx="5"/>
                    <rect class="s-ui" x="26" y="118" width="164" height="8"/>
                    <rect class="s-ui" x="36" y="36" width="64" height="44" rx="4"/>
                    <rect class="s-ui" x="36" y="86" width="40" height="24" rx="4"/>
                    <path class="s-stand" d="M96 132h24l4 16H92z"/>
                    <rect class="s-body" x="82" y="148" width="52" height="5" rx="2.5"/>
                    <rect class="s-body" x="208" y="58" width="102" height="62" rx="11"/>
                    <rect class="s-screen" x="214" y="64" width="90" height="50" rx="6"/>
                    <rect class="glow" x="214" y="64" width="90" height="50" rx="6"/>
                    <text class="s-text" x="259" y="48" text-anchor="middle">Display 2</text>
                    <g class="a-window">
                      <rect class="s-win" x="112" y="50" width="62" height="40" rx="4"/>
                      <rect class="s-accent" x="112" y="50" width="62" height="8" rx="3"/>
                      <rect class="s-ui" x="118" y="64" width="34" height="5" rx="2.5"/>
                      <rect class="s-ui" x="118" y="73" width="48" height="5" rx="2.5"/>
                      <path class="s-cursor" d="M150 52v13l3.5-3.2 2.6 5.6 2.4-1.1-2.6-5.5h4.8z"/>
                    </g>
                  </svg>
