---
// The app's screens on one large device: pick a screen from the list, turn the
// device between portrait and landscape, and switch the app between its
// Midnight and Paper themes (which follows the site's theme until picked).
// Without scripts it shows Home in Midnight.
import { Image } from "astro:assets";
import home from "../assets/screens/home.png";
import homeLand from "../assets/screens/home-land.png";
import homePaper from "../assets/screens/home-paper.png";
import homeLandPaper from "../assets/screens/home-land-paper.png";
import overview from "../assets/screens/overview.png";
import overviewLand from "../assets/screens/overview-land.png";
import overviewPaper from "../assets/screens/overview-paper.png";
import overviewLandPaper from "../assets/screens/overview-land-paper.png";
import controls from "../assets/screens/controls.png";
import controlsLand from "../assets/screens/controls-land.png";
import controlsPaper from "../assets/screens/controls-paper.png";
import controlsLandPaper from "../assets/screens/controls-land-paper.png";
import night from "../assets/screens/night.png";
import nightLand from "../assets/screens/night-land.png";
import nightPaper from "../assets/screens/night-paper.png";
import nightLandPaper from "../assets/screens/night-land-paper.png";
import settings from "../assets/screens/settings.png";
import settingsLand from "../assets/screens/settings-land.png";
import settingsPaper from "../assets/screens/settings-paper.png";
import settingsLandPaper from "../assets/screens/settings-land-paper.png";

const screens = [
  {
    id: "home",
    name: "Home",
    text: "The time, a greeting and the numbers you check most, with sound and quick controls.",
    alt: "Home: the time, a greeting, CPU, GPU and memory, media, sound and quick controls",
    portrait: home,
    landscape: homeLand,
    portraitPaper: homePaper,
    landscapePaper: homeLandPaper,
  },
  {
    id: "overview",
    name: "Overview",
    text: "Every sensor at once: CPU history, each GPU by name, memory, battery, network and disk.",
    alt: "Overview: CPU load with history, both GPUs, memory, battery, network and disk",
    portrait: overview,
    landscape: overviewLand,
    portraitPaper: overviewPaper,
    landscapePaper: overviewLandPaper,
  },
  {
    id: "controls",
    name: "Controls",
    text: "Sound output and volume, brightness, power profiles, the MangoHud overlay and PC power.",
    alt: "Controls: sound output and volume, brightness, power profiles, the MangoHud overlay and PC power",
    portrait: controls,
    landscape: controlsLand,
    portraitPaper: controlsPaper,
    landscapePaper: controlsLandPaper,
  },
  {
    id: "night",
    name: "Night",
    text: "A big clock on pure black for a phone docked overnight. Easy on OLED and on your eyes.",
    alt: "Night dock: a large clock, the date and small stats on black",
    portrait: night,
    landscape: nightLand,
    portraitPaper: nightPaper,
    landscapePaper: nightLandPaper,
  },
  {
    id: "settings",
    name: "Settings",
    text: "Keep the screen on while charging, dim when idle, protect OLED from burn-in, and more.",
    alt: "Settings: your name, dock and screen options, the navigation bar and your PCs",
    portrait: settings,
    landscape: settingsLand,
    portraitPaper: settingsPaper,
    landscapePaper: settingsLandPaper,
  },
];
---
<div class="showcase" data-showcase data-orientation="portrait" data-look="midnight">
  <div class="show-side">
    <div class="show-toggles">
    <div class="orient" role="group" aria-label="Orientation">
      <button type="button" data-orient="portrait" aria-pressed="true">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/></svg>
        Portrait
      </button>
      <button type="button" data-orient="landscape" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="7" width="19" height="10" rx="2.5"/><path d="M18.5 11v2"/></svg>
        Landscape
      </button>
    </div>
    <div class="orient" role="group" aria-label="App theme">
      <button type="button" data-look="midnight" aria-pressed="true">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
        Midnight
      </button>
      <button type="button" data-look="paper" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/></svg>
        Paper
      </button>
    </div>
    </div>

    <div class="show-list" role="tablist" aria-label="Screens">
      {screens.map((screen, i) => (
        <button
          type="button"
          role="tab"
          id={`screen-tab-${screen.id}`}
          aria-controls="screen-stage"
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-screen={screen.id}
        >
          <span class="show-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="show-text">
            <b>{screen.name}</b>
            <span>{screen.text}</span>
          </span>
          <i class="show-progress" aria-hidden="true"></i>
        </button>
      ))}
    </div>
  </div>

  <div class="stage" id="screen-stage" role="tabpanel" aria-labelledby="screen-tab-home">
    <div class="stage-device">
      {screens.map((screen, i) => (
        <>
          {[
            ["midnight", screen.portrait, screen.landscape, ""],
            ["paper", screen.portraitPaper, screen.landscapePaper, ", in the Paper theme"],
          ].map(([look, portrait, landscape, note]) => (
            <>
              <Image
                src={portrait}
                widths={[290, 580]}
                sizes="290px"
                alt={`${screen.alt}${note}`}
                class:list={["stage-shot", { active: i === 0 && look === "midnight" }]}
                data-screen={screen.id}
                data-orient="portrait"
                data-look={look}
                loading="lazy"
              />
              <Image
                src={landscape}
                widths={[680, 1360]}
                sizes="(max-width: 760px) 92vw, 680px"
                alt={`${screen.alt}, in landscape${note}`}
                class="stage-shot"
                data-screen={screen.id}
                data-orient="landscape"
                data-look={look}
                loading="lazy"
              />
            </>
          ))}
        </>
      ))}
    </div>
    <p class="stage-caption" data-caption>{screens[0].text}</p>
  </div>
</div>
