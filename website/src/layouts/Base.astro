---
// The page shell: every tag a search engine or a link preview reads.
import "../styles/global.css";
import spaceGrotesk from "../assets/fonts/space_grotesk.woff2?url";
import { version } from "../../../yae_version.json";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
const repo = "https://github.com/DragonEmperor9480/yaedock";

// Lets search engines show YaeDock as free software for Linux and Android.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "YaeDock",
  description,
  url: canonical.href,
  image: ogImage.href,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Linux, Android 8.0+",
  softwareVersion: version,
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  downloadUrl: `${repo}/releases/latest`,
  codeRepository: repo,
  author: { "@type": "Person", name: "DragonEmperor9480", url: "https://github.com/DragonEmperor9480" },
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical.href}>
<meta name="theme-color" content="#090B0F">
<meta name="color-scheme" content="dark light">

<meta property="og:type" content="website">
<meta property="og:site_name" content="YaeDock">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical.href}>
<meta property="og:image" content={ogImage.href}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="YaeDock: the fox logo beside the app's dock screen">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage.href}>

<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
<link rel="sitemap" href={`${base}sitemap-index.xml`}>
<link rel="preload" href={spaceGrotesk} as="font" type="font/woff2" crossorigin>
<script is:inline>
  // Set the theme before the first paint: the saved choice, else the system's.
  (() => {
    const root = document.documentElement;
    root.classList.add("js");
    let theme = null;
    try { theme = localStorage.getItem("theme"); } catch {}
    if (theme !== "light" && theme !== "dark") {
      theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
    }
    root.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]').content = theme === "light" ? "#F5F0E8" : "#090B0F";
  })();
</script>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
<body>
<slot />
<script>
  import "../scripts/main.js";
</script>
</body>
</html>
