<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The Wi-Fi band, generation and signal shown in the PC menu; never asks the user. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The connection runs as a foreground service while a PC is connected. Its
         connectedDevice type needs one of the network permissions below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- This phone as the PC's microphone, which carries on in the background. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- For the lock that keeps Wi-Fi from dozing while video or sound streams. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Rumble from games played with the phone as a controller. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- About > Updates installs a new version of the app, after the user allows it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The camera is only for scanning the pairing QR code; manual entry works without one. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Talking to the PC over the USB cable, with the PC as the USB host. -->
    <uses-feature android:name="android.hardware.usb.accessory" android:required="false" />

    <application
        android:name=".YaeDockApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".DockActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- For the USB cable: a PC running YaeDock that the phone is plugged into opens the
             app through this, which also grants it the cable. Turned off with the cable
             setting, so Android does not ask about a cable the app will not use. -->
        <activity-alias
            android:name=".CableHandler"
            android:targetActivity=".DockActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity-alias>

        <!-- One launcher entry per app icon; Settings > Themes enables one and disables the
             rest. The first is Midnight, the default: it keeps the activity's old name, so
             home screen shortcuts made before there were icons still find it. -->
        <activity-alias
            android:name=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".DockActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPaper"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_paper"
            android:roundIcon="@mipmap/ic_launcher_paper"
            android:targetActivity=".DockActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconVoid"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_void"
            android:roundIcon="@mipmap/ic_launcher_void"
            android:targetActivity=".DockActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconOcean"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ocean"
            android:roundIcon="@mipmap/ic_launcher_ocean"
            android:targetActivity=".DockActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSakura"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sakura"
            android:roundIcon="@mipmap/ic_launcher_sakura"
            android:targetActivity=".DockActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".ConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone|camera" />

        <!-- The package installer's answer when the app installs an update of itself. -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />
    </application>

</manifest>
